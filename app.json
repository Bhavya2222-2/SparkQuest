{
  "expo": {
    "name": "SparkQuest",
    "slug": "sparkquest",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "sparkquest",
    "splash": { "backgroundColor": "#ffffff" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bhavyapatel.aistudy",
      "buildNumber": "5",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "SparkQuest uses notifications to remind you about your planned study tasks.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bhavyapatel.aistudy",
      "adaptiveIcon": { "backgroundColor": "#ffffff" },
      "notification": { "color": "#0a84ff", "sound": true }
    },
    "web": { "favicon": "" },
    "plugins": ["expo-notifications", "expo-secure-store"],
    "extra": {
      "eas": { "projectId": "e091a696-176d-4001-8314-d9c224f9389c" }
    }
  }
}
